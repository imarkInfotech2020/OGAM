<?xml version="1.0" encoding="utf-8"?>
<!--
  The narrowest configuration that can do the job.

  Selection changes provide only the text the user highlighted. View clicks let the service see the
  explicit Copy or Cut command. It ignores every other click. No `canRetrieveWindowContent`, no
  key-event filtering, and no window-state events are enabled.

  `accessibilityFlags` is left at the default for the same reason: reporting flags are what widen a
  service's reach, and this one asks for none.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewTextSelectionChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:description="@string/sync_clipboard_accessibility_description"
    android:notificationTimeout="100"
    android:summary="@string/sync_clipboard_accessibility_summary" />
